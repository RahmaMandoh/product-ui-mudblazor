@* Top bar for the content column only, not the sidebar. The wrapping
   <div class="app-header-shell"> gives AppHeader.razor.css's `::deep`
   selectors something to anchor to. No `dir` set here — RTL comes once,
   globally, from MainLayout's MudRTLProvider. *@
<div class="app-header-shell">
    <header class="app-header-bar">
        @* Opens the sidebar drawer on small screens; hidden at desktop
           widths, where the sidebar is always visible. *@
        <MudIconButton Icon="@Icons.Material.Outlined.Menu"
                       Color="Color.Default"
                       Class="app-header-icon-btn app-header-hamburger-btn"
                       OnClick="OnMenuClick"
                       aria-label="فتح القائمة الجانبية" />

        <MudAvatar Class="app-header-avatar" Color="Color.Default" Size="Size.Medium">
            ر
        </MudAvatar>

        @* MudBadge already caps the count and appends "+" — no custom
           counter needed. *@
        <MudBadge Content="@_notificationCount" Max="9" Overlap="true" Color="Color.Default"
                  BadgeClass="app-header-notif-badge"
                  BadgeAriaLabel="@($"{_notificationCount} إشعارات جديدة")">
            <MudIconButton Icon="@Icons.Material.Outlined.Notifications"
                           Color="Color.Default"
                           Class="app-header-icon-btn"
                           aria-label="الإشعارات" />
        </MudBadge>

        <MudIconButton Icon="@Icons.Material.Outlined.Settings"
                       Color="Color.Default"
                       Class="app-header-icon-btn"
                       aria-label="الإعدادات" />

        @* Dark/light toggle — visual only for now; see @code below. Size
           is Large, not Medium, so its clickable area clears the 44x44px
           touch-target minimum. *@
        <MudSwitch ThumbIcon="@Icons.Material.Outlined.DarkMode"
         T="bool" Value="_isDarkMode" ValueChanged="OnDarkModeToggled"
                   Color="Color.Default" UncheckedColor="Color.Default"
                   Size="Size.Large"
                   Class="app-header-theme-switch"
                   aria-label="الوضع الداكن" />
                @* Thumb icon color still isn't picking up the override in
                   AppHeader.razor.css — needs another look. *@

        <MudButton Class="app-header-sync-btn"
                   Variant="Variant.Filled"
                   Color="Color.Default"
                   StartIcon="@Icons.Material.Filled.CheckCircle">
            @* Span lets the label hide visually on small screens while
               staying available to screen readers — see the CSS. *@
            <span class="app-header-sync-label">المزامنة</span>
        </MudButton>
    </header>
</div>

@code {
    // Fires up to MainLayout, which owns the drawer's open/closed state.
    [Parameter] public EventCallback OnMenuClick { get; set; }

    // Demo placeholder count, not real notification data.
    private int _notificationCount = 10;

    private bool _isDarkMode;

    private void OnDarkModeToggled(bool value)
    {
        _isDarkMode = value;

        // TODO: only flips the switch visually. Actually switching the
        // theme needs MudThemeProvider.IsDarkMode + AppTheme.cs's
        // PaletteDark — out of scope for this task.
    }
}
