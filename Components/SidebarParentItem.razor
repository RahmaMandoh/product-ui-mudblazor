@* Expandable nav group header, wrapping MudNavGroup. IconColor="Inherit"
   avoids MudBlazor's fixed-color default so our own token wins.
   `_expanded` mirrors MudNavGroup's real state via @bind-Expanded so the
   "sidebar-parent-expanded" class doesn't go stale after a toggle. *@
<MudNavGroup Title="@Title"
             Icon="@Icon"
             IconColor="Color.Inherit"
             @bind-Expanded="_expanded"
             Class="@(_expanded ? "sidebar-parent-expanded" : null)">
    @ChildContent
</MudNavGroup>

@code {
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string? Icon { get; set; }

    [Parameter]
    public bool Expanded { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private bool _expanded;

    protected override void OnInitialized()
    {
        _expanded = Expanded;
    }
}
