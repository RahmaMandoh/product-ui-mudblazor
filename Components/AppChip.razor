@* AppChip.razor — shared static pill-shaped tag. Used for Screen B's
   "نموذج 1" tag next to "لقد اخترت:". The reference shows this as a plain
   label with no click or remove action, so it renders as a plain <span> —
   no button, no focus ring, no touch-target sizing, since none of that
   applies to something that isn't interactive. Text then icon, matching
   the right-to-left reading order the rest of this library uses. *@
<span class="app-chip">
    <span class="app-chip__label">@Text</span>
    @if (!string.IsNullOrEmpty(Icon))
    {
        <MudIcon Icon="@Icon" Color="Color.Inherit" Class="app-chip__icon" aria-hidden="true" />
    }
</span>

@code {
    [Parameter, EditorRequired] public string Text { get; set; } = string.Empty;

    /// Optional icon, rendered after the text. Leave unset for no icon and
    /// no reserved gap — same as AppButton's optional Icon.
    [Parameter] public string? Icon { get; set; }
}
