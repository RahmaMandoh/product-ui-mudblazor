@* Regular nav link, reused for top-level and nested rows — font size
   differs only via CSS depth in AppSidebar.razor.css, not a parameter. *@
<MudNavLink Href="@Href" Match="@Match" Icon="@Icon" IconColor="Color.Inherit">
    @if (!string.IsNullOrEmpty(CustomIcon))
    {
        <img src="@CustomIcon"
             class="sidebar-custom-icon"
             alt="" />
    }
    @Text
</MudNavLink>

@code {
    [Parameter, EditorRequired]
    public string Text { get; set; } = string.Empty;

    [Parameter]
    public string? Href { get; set; }

    [Parameter]
    public string? Icon { get; set; }

    [Parameter]
    public NavLinkMatch Match { get; set; } = NavLinkMatch.All;
    
    [Parameter]
    public string? CustomIcon { get; set; }
}
