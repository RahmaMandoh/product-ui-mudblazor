@* Shared sync action banner (Figma's "btn_box"). One component instead
   of two hand-built banners. States: Default/Hover/pressed, no Disabled —
   see AppButton. Bordered defaults true; Screen A passes false since its
   banners share one outer panel — see .app-sync-block in components.css. *@

<div class="@RootClass">
    <div class="app-action-banner__content">
        <span class="app-action-banner__badge" aria-hidden="true">
            <MudIcon Icon="@Icon" Color="Color.Inherit" Size="Size.Medium" />
        </span>
        <MudStack Spacing="0">
            <MudText Class="app-action-banner__title" Typo=" Typo.body1">@Title</MudText>
            <MudText Class="app-action-banner__description" Typo="Typo.body2">@Description</MudText>
        </MudStack>
    </div>
    <AppButton Icon="@Icons.Material.Filled.ChevronLeft" 
           IconPosition="Adornment.End" 
           OnClick="OnClick">
    @ButtonLabel
</AppButton>
</div>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;

    [Parameter, EditorRequired] public string Description { get; set; } = string.Empty;

    [Parameter, EditorRequired] public string ButtonLabel { get; set; } = string.Empty;

    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }

    /// True (default) draws this component's own bordered card — see
    /// header comment.
    [Parameter] public bool Bordered { get; set; } = true;

    private string RootClass => (Bordered ? "app-panel " : "") + "app-action-banner";

    [Parameter]
    public string Icon { get; set; } = Icons.Material.Filled.Sync;
}
