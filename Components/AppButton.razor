@* Shared Primary Button, used the same way on both screens. Wraps
   MudButton (Filled + Primary), styled via .app-btn-primary in
   components.css. Only Primary/Filled exists so far — other variants
   aren't built until the design shows them. Icon/IconPosition map onto
   MudButton's separate StartIcon/EndIcon; icon color/size are left at
   MudButton's own defaults, which already do the right thing. *@

<MudButton Variant="Variant.Filled"
           Color="Color.Primary"
           Class="app-btn-primary"
           Disabled="Disabled"
           StartIcon="@(IconPosition == Adornment.Start ? Icon : null)"
           EndIcon="@(IconPosition == Adornment.End ? Icon : null)"
           OnClick="OnClick"
           UserAttributes="@AdditionalAttributes">
    @ChildContent
</MudButton>

@code {
    /// Optional icon (e.g. Icons.Material.Filled.Sync). Null renders none.
    [Parameter] public string? Icon { get; set; }

    /// Which side Icon renders on. Defaults to Start.
    [Parameter] public Adornment IconPosition { get; set; } = Adornment.Start;

    [Parameter] public bool Disabled { get; set; }

    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// Passed straight to MudButton — e.g. aria-label for an icon-only button.
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }
}
