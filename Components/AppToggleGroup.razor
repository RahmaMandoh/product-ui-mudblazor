@* Shared two-option segmented control. Custom, not MudBlazor's
   MudToggleGroup — that always renders role="checkbox", wrong ARIA for
   a mutually-exclusive choice — so this is a hand-wired radiogroup
   reusing its look through the same tokens. Arrow keys jump between
   items, simplified to "any arrow = the other one" for 2 options only. *@
@typeparam T

<div class="app-toggle-group" role="radiogroup" aria-label="@AriaLabel">
    @for (var i = 0; i < Options.Count; i++)
    {
        var index = i;
        var option = Options[index];
        var isSelected = EqualityComparer<T>.Default.Equals(option.Value, SelectedValue);
        <button @ref="_itemRefs[index]"
                type="button"
                role="radio"
                aria-checked="@(isSelected ? "true" : "false")"
                tabindex="@(isSelected ? 0 : -1)"
                class="@GetItemClass(isSelected)"
                disabled="@Disabled"
                @onclick="@(() => SelectAsync(index))"
                @onkeydown="@(e => OnKeyDownAsync(e, index))">
            @if (option.IconPosition == Adornment.Start)
            {
                <MudIcon Icon="@option.Icon" Color="Color.Inherit" Class="app-toggle-group__icon" aria-hidden="true" />
            }
            <span class="app-toggle-group__label">
                @option.Label
                @if (!string.IsNullOrEmpty(option.Note))
                {
                    <span class="app-toggle-group__note">(@option.Note)</span>
                }
            </span>
            @if (option.IconPosition == Adornment.End)
            {
                <MudIcon Icon="@option.Icon" Color="Color.Inherit" Class="app-toggle-group__icon" aria-hidden="true" />
            }
        </button>
    }
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<AppToggleOption<T>> Options { get; set; } = Array.Empty<AppToggleOption<T>>();

    [Parameter] public T SelectedValue { get; set; } = default!;
    [Parameter] public EventCallback<T> SelectedValueChanged { get; set; }

    [Parameter] public bool Disabled { get; set; }

    /// This group's accessible name — the visible heading next to it isn't
    /// linked automatically, so pass it explicitly.
    [Parameter, EditorRequired] public string AriaLabel { get; set; } = string.Empty;

    private readonly List<ElementReference> _itemRefs = new();

    protected override void OnParametersSet()
    {
        while (_itemRefs.Count < Options.Count)
        {
            _itemRefs.Add(default);
        }
    }

    private string GetItemClass(bool isSelected) =>
        isSelected
            ? "app-toggle-group__item app-toggle-group__item--selected"
            : "app-toggle-group__item";

    private Task SelectAsync(int index)
    {
        if (Disabled)
        {
            return Task.CompletedTask;
        }
        return SelectedValueChanged.HasDelegate
            ? SelectedValueChanged.InvokeAsync(Options[index].Value)
            : Task.CompletedTask;
    }

    /// Any arrow key moves to "the other" item — see header comment.
    private async Task OnKeyDownAsync(KeyboardEventArgs e, int index)
    {
        if (Disabled || Options.Count < 2)
        {
            return;
        }
        if (e.Key is "ArrowLeft" or "ArrowRight" or "ArrowUp" or "ArrowDown")
        {
            var nextIndex = (index + 1) % Options.Count;
            await SelectAsync(nextIndex);
            await _itemRefs[nextIndex].FocusAsync();
        }
    }
}
