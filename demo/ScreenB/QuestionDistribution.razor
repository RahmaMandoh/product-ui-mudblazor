@code {

    // Same 6 step titles/icons already verified against this exact reference
    // image in demo/StepperStatesGallery.razor — reused, not re-derived, per
    // that file's own "not invented placeholder text" note.
    // "ملخص الاختبار" (index 5) sets AlwaysShowLabel: true — confirmed
    // against demo/ScreenB/TaskTwo_Mobile.png, which keeps this one step's
    // label visible on mobile while the other 5 go icon-only (your call:
    // intentional design, the final/summary step kept as a labeled anchor
    // point, not an export artifact). See AppStepDefinition.cs for the flag
    // itself and responsive-rtl.css's .app-stepper__label--always-visible
    // for how it's honored below 600px.
    private readonly List<AppStepDefinition> _steps = new()
    {
        new(Icons.Material.Filled.Assignment, "بيانات الاختبار"),
        new(Icons.Material.Filled.LibraryBooks, "أختيار بنوك الأسئلة/الوحدات"),
        new(Icons.Material.Filled.Info, "أختيار الأسئلة"),
        new(Icons.Material.Filled.GridView, "تقسيم الأسئلة/الوحدات"),
        new(Icons.Material.Filled.Info, "مخططات التصحيح"),
        new(Icons.Material.Filled.Description, "ملخص الاختبار", AlwaysShowLabel: true),
    };

    // Starts at index 0 (بيانات الاختبار) — no reason found to start this
    // flow anywhere else; the earlier CurrentIndex="4" was purely to
    // reproduce one frozen Figma screenshot's mid-flow snapshot (see the
    // header comment above), not a real "where a fresh flow begins" signal.
    private int _currentIndex = 0;

    // AppStepItem never fires OnClick for a Disabled step (confirmed in its
    // own doc comment — the native `disabled` attribute blocks the click
    // before it ever reaches here), so every index this handler receives is
    // already guaranteed Pass, Selected, or Active — no bounds/state check
    // needed. Reassigning _currentIndex is the ONLY state this page owns:
    // AppStepper recomputes every other step's Pass/Active/Selected/Disabled
    // class purely from the new CurrentIndex on the next render (its
    // GetState() math, not anything tracked here), so clicking the
    // currently-Selected step correctly promotes it to Active, demotes the
    // old Active to Pass, and opens the next step as the new Selected, all
    // for free.
    private void OnStepClicked(int index) => _currentIndex = index;

    // "بيانات النموذج" panel mock data (CLAUDE.md demo/ScreenB — "mock
    // data"), matching TaskTwo_from_figma_design.png. _modelNameDisplay backs
    // the disabled field Figma gives no label of its own — see the FIELD
    // LABELS/STATES note above the markup and DECISIONS.md.
    private string? _modelNameDisplay = "نموذج 1";
    private string? _modelName = "نموذج 1";
    private string? _modelCode = "نموذج-كود-1";
    private string? _modelDescription = "1";

    // "توزيع الأسئلة" panel mock data (CLAUDE.md demo/ScreenB — "mock
    // data"). Order/IconPosition/default selection all pixel-confirmed
    // against TaskTwo_from_figma_design.png — see the markup's own header
    // comment above for the full reading, not re-derived here.
    private readonly List<AppToggleOption<string>> _distributionOptions = new()
    {
        new("drag", "سحب وإملاء", Icons.Material.Filled.DragIndicator, Adornment.Start),
        new("multi", "اختيار متعدد", Icons.Material.Filled.Checklist, Adornment.End),
    };
    private string _distributionMode = "drag";

    // Chip text mirrors the already-selected model name shown in the Model
    // Data panel above (_modelName) rather than a second independent mock
    // value — same "نموذج 1" the reference shows in both places.
    private string _selectedModelChipText => _modelName ?? string.Empty;

    private int _sectionCount = 2;

    // "مجمع بنوك العناصر" 3-column mock data (CLAUDE.md demo/ScreenB —
    // "mock data"). Search fields start empty — no venue/series-style mock
    // list backing them yet, same status as Screen A's own empty-Options
    // filter fields.
    private string? _searchSectionOne;
    private string? _searchSectionTwo;
    private string? _searchQuestionBank;

    // Card text/tags are an approximate transcription of the 3 sample cards
    // visible in demo/ScreenB/UI_ UX 2.jpeg — see the markup's own header
    // comment above for the full reading, not re-derived here.
    private readonly List<MockQuestionBankItem> _questionBankItems = new()
    {
        new() { PrimaryTagLabel = "AudioTest", SecondaryTagLabel = "بنك اسئلة" },
        new() {
            PrimaryTagLabel = "سؤال-639225061305407143-2",
            SecondaryTagLabel = "بنك اسئلة",
            Text = "أي من التالي يستخدم لتأمين الاتصال بين المتصفح وموقع الويب؟",
        },
        new() {
            PrimaryTagLabel = "سؤال-2",
            SecondaryTagLabel = "بنك اسئلة",
            Text = "أي من التالي يستخدم لتأمين الاتصال بين المتصفح وموقع الويب؟",
        },
    };

    // Mutable (not a record) — AppQuestionCard's CheckedChanged needs
    // somewhere to write the new value back to for the checkbox to actually
    // reflect a toggle.
    private sealed class MockQuestionBankItem
    {
        public required string PrimaryTagLabel { get; init; }
        public string? SecondaryTagLabel { get; init; }
        public string? Text { get; init; }
